# Room Switch feature — copy to .env for local dev, and set the same vars in your
# host's dashboard (Vercel/Netlify) for production.

# MongoDB Atlas connection string (Driver > Node.js). Include the DB user + password.
MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

MONGODB_DB="db name"

# Google OAuth Client ID (same value in both). The PUBLIC_ one is exposed to the
# browser for the Sign-in button; the private one is used server-side to verify tokens.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
